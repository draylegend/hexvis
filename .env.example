# Engine endpoint port (host and container; compose maps them 1:1)
ENGINE_PORT=8000
# 0 opens the endpoint immediately, checkpoints download on first request.
# 1 preloads all three checkpoints before binding (multi-GB first boot).
LAYA_PRELOAD=0
# Riot API personal key for ranked item statistics; a 1Password reference resolved by
# `op run` in app:serve. Empty turns collection off.
RIOT_API_KEY=
