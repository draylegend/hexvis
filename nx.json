{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"]
  },
  "nxCloudId": "6ab4638a250729628a735c9b",
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:unit-test": { "cache": true, "inputs": ["default", "^production"] }
  },
  "plugins": [{ "plugin": "@nx/oxlint", "options": { "targetName": "lint" } }],
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "formatter": "oxfmt",
      "linter": "oxlint",
      "style": "css",
      "unitTestRunner": "vitest-angular"
    }
  }
}
